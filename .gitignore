# Dependencies
node_modules/

# Frontend build output
dist/
dist-ssr/
*.local

# Rust / Tauri build output (also covered by src-tauri/.gitignore)
src-tauri/target/

# Downloaded models. The voice detection model ships in the repo, so builds need no download.
src-tauri/resources/models/*.gguf
src-tauri/resources/models/*.onnx
!src-tauri/resources/models/silero-vad-v6.2-F32.gguf

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Nix
result
result-*

# Env and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

archive