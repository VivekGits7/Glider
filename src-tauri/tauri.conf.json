{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glider",
  "version": "0.10.0",
  "identifier": "com.glider.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": ["resources/**/*"],
    "license": "MIT",
    "icon": [
      "icons/dark/32x32.png",
      "icons/dark/128x128.png",
      "icons/dark/128x128@2x.png",
      "icons/dark/icon.icns",
      "icons/dark/icon.ico"
    ],
    "macOS": {
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "images/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-layer-shell0",
          "libopenblas0",
          "libssl3t64 | libssl3"
        ],
        "files": {
          "/usr/lib/Glider": "transcribe-libs"
        }
      },
      "rpm": {
        "depends": [
          "libgtk-layer-shell.so.0()(64bit)",
          "libopenblas.so.0()(64bit)"
        ],
        "compression": {
          "type": "none"
        },
        "files": {
          "/usr/lib/Glider": "transcribe-libs"
        }
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib": "transcribe-libs"
        }
      }
    },
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/dark/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0RTkzNDE5OTQ1NEUKUldST1JabEJrMDRHQUZQY1BMVGhaamVRMXFYZXBXd1JzWGVhNGY1bzR0Sm9US0Q4VDdxTndnd1AK",
      "endpoints": [
        "https://github.com/VivekGits7/Glider/releases/latest/download/latest.json"
      ]
    }
  }
}
